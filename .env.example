# Optional: enables server-side email delivery for the contact form via Resend.
# Without it, the form falls back to opening the visitor's mail client.
RESEND_API_KEY=
CONTACT_TO_EMAIL=kaash0542@gmail.com

# Optional: search console verification tokens
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional: Google Analytics 4 (loads only after analytics consent)
NEXT_PUBLIC_GA_ID=
# Optional: Google AdSense — publisher id and default ad slot (ads.txt is generated from this)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
