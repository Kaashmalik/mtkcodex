# Copy to .env.local for local development. In production paste the same file into
# Netlify → Project configuration → Environment variables → "Import from a .env file".
# Full guide: docs/CRM.md → "Go-live checklist" (Step 0 covers Netlify and the domain).

# --- Required -----------------------------------------------------------------
# Admin login (/admin)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# 32+ random bytes (openssl rand -hex 32). Also keys analytics hashing and chat resume links.
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=https://mtkcodex.tech

# Database (Supabase). Run supabase/migrations/0001…0004 in order first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend: sending + receiving into the inbox) --------------------------
RESEND_API_KEY=
EMAIL_FROM="Kashif at MTK Codex <hello@mtkcodex.tech>"
CONTACT_TO_EMAIL=you@example.com
# Receiving: MX record from Resend + email.received webhook → /api/email/webhook
EMAIL_REPLY_DOMAIN=mtkcodex.tech
RESEND_WEBHOOK_SECRET=
# Optional: also forward every inbound email here
EMAIL_FORWARD_TO=

# --- Alerts on your phone / laptop -----------------------------------------------
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional Telegram backup alerts (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Live chat & booking --------------------------------------------------------
# Name shown to visitors in the chat
CHAT_AGENT_NAME=Kashif
# Free Cal.com / Google appointment page for video calls
NEXT_PUBLIC_BOOKING_URL=

# --- WhatsApp Cloud API (optional; outreach desk works without it) --------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0

# --- Campaigns: SMS / WhatsApp to consented contacts (/admin/campaigns) --------
# Run supabase/migrations/0006_campaigns.sql first. CRON_SECRET (below) also runs
# netlify/functions/campaigns-run.mjs every 15 minutes. WhatsApp campaigns use the
# WhatsApp Cloud API vars above plus a Meta-approved marketing template.
# Twilio: register an A2P 10DLC brand + campaign (or a verified toll-free number) first.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Messaging Service (MG…) is preferred; or a single sending number in TWILIO_FROM
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# Incoming-message webhook to set in Twilio: https://<your site>/api/sms/webhook

# --- MTK Hunter: remote jobs + AI proposals (/admin/opportunities) --------------
# Run supabase/migrations/0005_opportunities.sql first.
# AI (River, OpenAI-compatible): key from https://console.river.ai/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.river.ai/v1
LLM_MODEL_FAST=deepseek-ai/DeepSeek-V4.1-Flash
LLM_MODEL_WRITER=moonshotai/Kimi-K3.1-Pro
# Writer reasoning effort: none | low | high | max (low keeps drafts fast and cheap)
LLM_REASONING=low
# Hourly run (netlify/functions/hunter-run.mjs): openssl rand -hex 32
# Review/auto mode and daily numbers are set on the Hunter page, not here.
CRON_SECRET=
# Sender for proposals (same verified domain as EMAIL_FROM), and the email in your signature
OPP_EMAIL_FROM="Muhammad Kashif <kashif@mtkcodex.tech>"
OPP_CONTACT_EMAIL=kaash0542@gmail.com
OPP_DAILY_SEND_LIMIT=20
# Search terms, country you work from, and companies to watch directly
OPP_QUERIES=next.js,react,full stack,typescript,node.js,saas,automation,web scraping
OPP_COUNTRY=Pakistan
# greenhouse:<board>, lever:<slug>, ashby:<board> — e.g. greenhouse:vercel,ashby:linear
OPP_WATCHLIST=
# Optional tuning
OPP_EXTRA_SKILLS=
OPP_MAX_AGE_DAYS=21
OPP_MIN_SCORE=20
OPP_SCORE_BATCH=8
HIMALAYAS_API_KEY=

# --- Optional -------------------------------------------------------------------
# Private warehouse Google Sheet link shown in the admin
LEADS_SHEET_URL=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Google Analytics 4 / AdSense (load only after consent)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
